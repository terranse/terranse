[Unit]
Description=Periodic Game Save Backup
Documentation=https://github.com/your-repo/gaming-infra

[Timer]
# Run backup every hour
OnCalendar=hourly
# Also run 5 minutes after boot
OnBootSec=5min
# Randomize start within 10 minutes to avoid thundering herd
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
