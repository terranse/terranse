# Molecule managed dockerfile for e2e docker role testing
FROM {{ item.image }}

ENV DEBIAN_FRONTEND=noninteractive
ENV container=docker

# Install systemd and required packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        systemd \
        systemd-sysv \
        python3 \
        python3-apt \
        sudo \
        curl \
        ca-certificates \
        gnupg \
        procps \
        iproute2 \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /lib/systemd/system/multi-user.target.wants/* \
    && rm -f /etc/systemd/system/*.wants/* \
    && rm -f /lib/systemd/system/local-fs.target.wants/* \
    && rm -f /lib/systemd/system/sockets.target.wants/*udev* \
    && rm -f /lib/systemd/system/sockets.target.wants/*initctl* \
    && rm -f /lib/systemd/system/basic.target.wants/* \
    && rm -f /lib/systemd/system/anaconda.target.wants/*

# Create test user
RUN useradd -m -s /bin/bash default-user && \
    echo "default-user ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Create test directories for mounts
RUN mkdir -p /appdata /media/tv /media/movies /opt/docker

VOLUME ["/sys/fs/cgroup"]

CMD ["/lib/systemd/systemd"]
