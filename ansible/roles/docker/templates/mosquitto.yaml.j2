services:
  mosquitto:
    image: eclipse-mosquitto:2
    container_name: mosquitto
    extends:
      file: common.yaml
      service: base-service
    volumes:
      - "{{ service_mounts.config }}/mosquitto/config:/mosquitto/config"
      - "{{ service_mounts.config }}/mosquitto/data:/mosquitto/data"
      - "{{ service_mounts.config }}/mosquitto/log:/mosquitto/log"
    ports:
      # Loopback only: the broker allows anonymous access, so it must stay
      # reachable solely from inside this LXC (HA on host network) and from
      # the compose network (zigbee2mqtt).
      - 127.0.0.1:1883:1883
    restart: unless-stopped
