# Name-contract: this template requires a `devices` entry named `zigbee`
# (its /dev/serial/by-id/ path; an optional `adapter`, e.g. `deconz` for the
# ConBee II) declared on the host's tfvars `devices` list. See
# usb-serial-passthrough.yaml for the passthrough mechanics.
{% set zigbee_device = service_devices.zigbee | mandatory('zigbee2mqtt requires a device named "zigbee" in this LXC\'s devices list') %}
services:
  zigbee2mqtt:
    image: koenkk/zigbee2mqtt:2
    container_name: zigbee2mqtt
    extends:
      file: common.yaml
      service: base-service
    volumes:
      - "{{ service_mounts.config }}/zigbee2mqtt:/app/data"
      - /run/udev:/run/udev:ro
    devices:
      - "{{ zigbee_device.path }}:{{ zigbee_device.path }}"
    ports:
      - 8080:8080 # Z2M frontend
    depends_on:
      - mosquitto
    restart: unless-stopped
