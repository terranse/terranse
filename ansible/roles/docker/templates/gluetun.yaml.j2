services:
  # Windscribe WireGuard tunnel. qBittorrent shares this container's network
  # namespace (`network_mode: service:gluetun` in serverarr.yaml.j2), so all of its
  # traffic leaves through the tunnel and gluetun's firewall acts as the killswitch:
  # if the tunnel drops, qBittorrent has no route out at all.
  #
  # This was previously defined but wired to nothing. gluetun had no restart policy,
  # so it exited and stayed exited for three months, while qBittorrent ran on the
  # default bridge with its own published ports. Its egress IP was identical to the
  # host's, meaning every torrent went out over the bare connection.
  gluetun:
    image: qmcgaw/gluetun
    container_name: gluetun
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    ports:
      # Published here rather than on qbittorrent, which no longer has a network
      # namespace of its own and so cannot publish ports itself.
      - 8080:8080   # qBittorrent WebUI
    environment:
      TZ: Europe/Stockholm
      # Generate Windscribe credentials: https://windscribe.com/getconfig/wireguard
      VPN_SERVICE_PROVIDER: windscribe
      VPN_TYPE: wireguard
      WIREGUARD_PRIVATE_KEY: "{{ lookup('community.general.onepassword', 'Windscribe Wireguard Copenhagen', vault= 'HomeNetwork', section= 'Interface', field= 'PrivateKey') }}"
      WIREGUARD_ADDRESSES: "{{ lookup('community.general.onepassword', 'Windscribe Wireguard Copenhagen', vault= 'HomeNetwork', section= 'Interface', field= 'Address') }}"
      WIREGUARD_PRESHARED_KEY: "{{ lookup('community.general.onepassword', 'Windscribe Wireguard Copenhagen', vault= 'HomeNetwork', section= 'Peer', field= 'PreSharedKey') }}"
      WIREGUARD_ENDPOINT_PORT: "{{ lookup('community.general.onepassword', 'Windscribe Wireguard Copenhagen', vault= 'HomeNetwork', field= 'port') }}"
      # Let the LAN reach the WebUI. Without this the firewall drops replies to
      # anything that did not originate inside the tunnel, including a browser.
      FIREWALL_OUTBOUND_SUBNETS: 192.168.1.0/24,172.18.0.0/16
    healthcheck:
      test: ["CMD", "/gluetun-entrypoint", "healthcheck"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    restart: unless-stopped
