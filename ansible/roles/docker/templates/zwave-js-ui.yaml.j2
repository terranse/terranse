services:
  zwave-js-ui:
    image: zwavejs/zwave-js-ui:latest
    container_name: zwave-js-ui
    extends:
      file: common.yaml
      service: base-service
    volumes:
      - "{{ service_mounts.config }}/zwave-js-ui:/usr/src/app/store"
    devices:
      - "{{ service_devices.zwave.path }}:{{ service_devices.zwave.path }}"
    ports:
      - 8091:8091 # Web UI
      # Loopback only: HA's Z-Wave JS integration connects to this websocket
      # via the LXC loopback (HA runs with host networking).
      - 127.0.0.1:3000:3000
    restart: unless-stopped
