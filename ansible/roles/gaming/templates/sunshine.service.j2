[Unit]
Description=Sunshine Game Streaming Server
# User service in the gamer session. Sway starts it (via `systemctl --user
# start`) AFTER importing WAYLAND_DISPLAY into the user environment, so Sunshine
# reliably attaches to the running Sway output and captures it via KMS. No
# [Install]/WantedBy on purpose — Sway owns the lifecycle so the env is always
# imported before Sunshine launches. XDG_RUNTIME_DIR is implicit in user scope.
After=sway-gaming.service pipewire.service
Wants=pipewire.service

[Service]
Type=simple
# /usr/bin/sunshine carries cap_sys_admin+ep (set in sunshine.yaml), which is
# what KMS capture needs — so no AmbientCapabilities here.
ExecStart=/usr/bin/sunshine
Restart=on-failure
RestartSec=5
