{
  "env": {
    "PATH": "$(PATH):$(HOME)/.local/bin"
  },
  "apps": [
    {
      {# The gamescope session (Steam Big Picture) runs for the life of the guest,
         started by Sway — so there is nothing for Sunshine to launch and, more
         importantly, nothing for it to KILL. Sunshine terminates the app it launched
         when a client disconnects: with Steam as a Sunshine "app", quitting the stream
         took Steam down with it, and the next connect showed an empty desktop with no
         hint why. Streaming the session as-is means reconnecting lands exactly where
         you left off, mid-game. #}
      "name": "Steam Big Picture",
      "image-path": "steam.png",
      "cmd": "",
      "auto-detach": true
    },
    {
      {# Blocks while Heroic is open, so quitting Heroic ends the stream. #}
      "name": "Heroic",
      "image-path": "",
      "cmd": "/opt/game-sync/bin/game-sync-epic heroic",
      "auto-detach": false,
      "wait-all": false,
      "exit-timeout": 30
    }{% if retroarch_enabled | bool %},
    {
      {# Browses every ROM; only a curated few get their own card. #}
      "name": "ES-DE",
      "image-path": "",
      "cmd": "/opt/game-sync/bin/game-sync-retro es-de",
      "auto-detach": false,
      "wait-all": false,
      "exit-timeout": 30
    }{% endif %}

  ]
}
