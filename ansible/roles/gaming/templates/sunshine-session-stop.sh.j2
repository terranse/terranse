#!/bin/bash
# Sunshine Session Stop Hook
# Notifies GPU manager that a gaming session has ended
#
# Managed by Ansible - do not edit manually

# Best-effort cleanup (the `undo` of a global_prep_cmd) — never abort.
SESSION_STATE_DIR="{{ sunshine_session_state_dir | default('/mnt/gaming/session-state') }}"
VM_ID="{{ vm_id | default(ansible_hostname) }}"
HOSTNAME=$(hostname)
SESSION_FILE="${SESSION_STATE_DIR}/${HOSTNAME}.session"

# Log function
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [sunshine-hook] $1" >> /var/log/sunshine-hooks.log 2>/dev/null || true
}

log "Session ending for VM: ${VM_ID}"

# Update session state to inactive
if [[ -f "${SESSION_FILE}" ]]; then
    # Read existing session data and update status
    jq --arg stop "$(date -Iseconds)" '.status = "inactive" | .session_end = $stop' \
        "${SESSION_FILE}" > "${SESSION_FILE}.tmp" 2>/dev/null && \
        mv "${SESSION_FILE}.tmp" "${SESSION_FILE}" || \
        rm -f "${SESSION_FILE}"

    log "Session state updated to inactive"
else
    log "No session file found at ${SESSION_FILE}"
fi

{% if sunshine_session_stop_extra is defined %}
# Custom session stop commands
{{ sunshine_session_stop_extra }}
{% endif %}

exit 0
