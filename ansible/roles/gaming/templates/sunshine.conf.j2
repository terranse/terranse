# Sunshine Configuration for Cloud Gaming (Wayland)
# Managed by Ansible - do not edit manually

# =============================================================================
# Encoder settings
# =============================================================================
encoder = {{ 'nvenc' if gpu_type == 'nvidia_vgpu' else 'vaapi' }}
hevc_mode = 1

# =============================================================================
# Capture settings - Wayland via KMS
# =============================================================================
# KMS capture provides direct DRM framebuffer access
# Works with gamescope, cage, sway, and other wlroots compositors
capture = wlr

# =============================================================================
# Display settings
# =============================================================================
adapter_name = /dev/dri/renderD128
# Virtual display is created by the Wayland compositor (gamescope/cage/sway)
# Resolution is set via compositor config, not here

# =============================================================================
# Audio settings - PipeWire (Wayland standard)
# =============================================================================
# The sway session creates this null sink (the guest has no sound card). Sunshine
# switches the default sink to `virtual_sink` at stream start and captures its
# monitor, so both must name the sink the session actually created.
audio_sink = {{ sunshine_audio_sink_name }}.monitor
virtual_sink = {{ sunshine_audio_sink_name }}

# =============================================================================
# Input settings
# =============================================================================
gamepad = true
keyboard = true
mouse = true

# =============================================================================
# Network settings
# =============================================================================
origin_web_ui_allowed = wan

# Sunshine rejects web-UI requests whose Origin it does not know ("The request
# was blocked by CSRF protection"), and it only knows localhost by default — so
# reaching the UI at the VM's address is refused. This is not a DNS problem: the
# hostname would be rejected just the same. Allow every address the UI is
# actually reached by.
csrf_allowed_origins = {{ sunshine_csrf_allowed_origins | to_json }}

# =============================================================================
# Logging
# =============================================================================
min_log_level = 2

# =============================================================================
# Headless mode
# =============================================================================
# Allows Sunshine to run without a physical display
# The virtual display is created by the Wayland compositor
headless = true

# =============================================================================
# Session hooks for GPU management
# =============================================================================
# These notify the GPU manager when sessions start/stop
global_prep_cmd = [{"do": "/opt/sunshine/hooks/session-start.sh", "undo": "/opt/sunshine/hooks/session-stop.sh"}]
