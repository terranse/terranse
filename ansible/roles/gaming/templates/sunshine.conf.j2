# Sunshine Configuration for Cloud Gaming (Wayland)
# Managed by Ansible - do not edit manually

# =============================================================================
# Encoder settings
# =============================================================================
encoder = {{ 'nvenc' if gpu_type == 'nvidia_vgpu' else 'vaapi' }}
hevc_mode = 1

# =============================================================================
# Capture settings - Wayland via KMS
# =============================================================================
# KMS capture provides direct DRM framebuffer access
# Works with gamescope, cage, sway, and other wlroots compositors
capture = wlr

# =============================================================================
# Display settings
# =============================================================================
adapter_name = /dev/dri/renderD128
# Virtual display is created by the Wayland compositor (gamescope/cage/sway)
# Resolution is set via compositor config, not here

# =============================================================================
# Audio settings - PipeWire (Wayland standard)
# =============================================================================
# Both are SINK names, not monitor names — Sunshine appends ".monitor" itself.
# Passing "<sink>.monitor" here makes it search for a *sink* by that name, find
# nothing, and fail every stream with pa_simple_new(). The sink itself is declared
# in /etc/pipewire/pipewire.conf.d (see pipewire-sunshine-sink.conf.j2).
audio_sink = {{ sunshine_audio_sink_name }}
virtual_sink = {{ sunshine_audio_sink_name }}

# =============================================================================
# Input settings
# =============================================================================
# A controller TYPE, not a boolean. `true` is not a valid value: Sunshine
# falls back to auto-detect and picks whatever the client reports, which gave
# a DualShock 5 mapping for an Xbox-layout pad and mismatched every button.
gamepad = {{ sunshine_gamepad | default('xone') }}
keyboard = true
mouse = true

# =============================================================================
# Network settings
# =============================================================================
origin_web_ui_allowed = wan

# Sunshine rejects web-UI requests whose Origin it does not know ("The request
# was blocked by CSRF protection"), and it only knows localhost by default — so
# reaching the UI at the VM's address is refused. This is not a DNS problem: the
# hostname would be rejected just the same. Allow every address the UI is
# actually reached by.
csrf_allowed_origins = {{ sunshine_csrf_allowed_origins | to_json }}

# =============================================================================
# Logging
# =============================================================================
min_log_level = 2

# =============================================================================
# Headless mode
# =============================================================================
# Allows Sunshine to run without a physical display
# The virtual display is created by the Wayland compositor
headless = true

# =============================================================================
# Session hooks for GPU management
# =============================================================================
# These notify the GPU manager when sessions start/stop
global_prep_cmd = [{"do": "/opt/sunshine/hooks/session-start.sh", "undo": "/opt/sunshine/hooks/session-stop.sh"}]

# =============================================================================
# Latency
# =============================================================================
# Favour latency over image quality: this is an interactive LAN stream. NVENC
# preset 1 is the fastest; two-pass and spatial AQ spend encode time on quality;
# FEC overhead is largely wasted on a wired link.
nvenc_preset = {{ sunshine_nvenc_preset | default(1) }}
nvenc_twopass = {{ sunshine_nvenc_twopass | default('disabled') }}
nvenc_spatial_aq = {{ sunshine_nvenc_spatial_aq | default('disabled') }}
nvenc_vbv_increase = {{ sunshine_nvenc_vbv_increase | default(0) }}
fec_percentage = {{ sunshine_fec_percentage | default(10) }}
