[Unit]
Description=Gamescope session (Steam Big Picture)
Documentation=https://github.com/ValveSoftware/gamescope
# Sway is the OUTER compositor and exists only to give Sunshine a headless wl_output
# to capture. It is a tiling window manager and a terrible fit for a streaming console:
# it hands each new window a slice of the screen, so a game launched next to Big
# Picture is mapped at half width, fixes its swapchain to that, and then ignores the
# resize when a fullscreen rule fires — half the picture ends up off the display. Games
# also shrink Big Picture when they exit, and dialogs open at whatever size they like.
# Every workaround for that is a fight with the window manager.
#
# gamescope is the tool built for this job (it is what the Steam Deck runs). It presents
# a FIXED 1920x1080 virtual display and scales every client to fill it, so no client
# ever negotiates geometry with anything. Nested inside sway it is a single fullscreen
# window that never changes, which leaves sway with nothing to manage.
#
# -e enables Steam's gamescope integration, which is also what provides the on-screen
# keyboard — without it there is no way to type a password into the EA App from a couch.
#
# --xwayland-count 2 / STEAM_MULTIPLE_XWAYLANDS=1 ask for the Steam UI and games to
# live on SEPARATE X servers, as the Steam Deck's own gamescope-session does.
#
# The problem being chased: with a single Xwayland the game and the full-screen Big
# Picture window are siblings on one display, and gamescope shows whichever holds
# focus. Anything that makes Steam take focus (a controller reconnecting, an
# achievement toast) therefore REPLACES the game with Big Picture for as long as it
# holds it — measured at 7.5s of black showing nothing but Big Picture's controller
# footer, while the game carried on rendering underneath. Big Picture reports
# STEAM_OVERLAY=0 and STEAM_NOTIFICATION=0, so it never asks to be composited *over*
# the game; gamescope has no reason to layer it, only to swap to it.
#
# HONEST STATUS (2026-07-27): this only fixes Steam's half. Verified on the running
# guest that Steam now does the right thing — STEAM_MULTIPLE_XWAYLANDS=1 is set,
# STEAM_GAME_DISPLAY_0 becomes :2, and the game process really is handed DISPLAY=:2.
# But across two clean launches the game's WINDOW still mapped on :1 beside Big
# Picture, and :2 stayed empty with no GAMESCOPE_* root atoms on it at all — i.e.
# gamescope 3.16.20 (the only version Ubuntu 26.04 ships) is not managing the second
# server as a game display. The sibling arrangement that causes the blackout is
# therefore UNCHANGED, and the bug is expected to persist.
#
# Kept anyway because it is the prerequisite half and costs nothing measurable: a
# game launches and runs normally under it. Set gamescope_xwayland_count: 1 to revert.
# The remaining suspect is gamescope itself, which would mean building from source.
After=sway-gaming.service
BindsTo=sway-gaming.service

[Service]
Type=simple
# gamescope gives its children an X11 display (:1). If Steam can still see the parent
# compositor's Wayland socket it connects THERE, bypassing gamescope entirely and
# landing straight back in sway's lap — so scrub WAYLAND_DISPLAY for the child only.
ExecStart={{ gamescope_bin | default('/usr/games/gamescope') }} \
    -W {{ gaming_width | default(1920) }} \
    -H {{ gaming_height | default(1080) }} \
    -r {{ gaming_refresh | default(60) }} \
    -f -e \
    --xwayland-count {{ gamescope_xwayland_count | default(2) }} \
    -- env -u WAYLAND_DISPLAY STEAM_MULTIPLE_XWAYLANDS=1 /opt/sunshine/launch-steam.sh -gamepadui
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
