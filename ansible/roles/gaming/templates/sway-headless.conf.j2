# Sway configuration for headless gaming
# Creates a virtual display that Sunshine captures via KMS for streaming.
#
# Managed by Ansible - do not edit manually
#
# Sunshine is NOT launched from here — it runs as its own user service ordered
# after sway, and captures this session. Likewise individual games/launchers are
# started on demand as Sunshine app entries (Moonlight picks one), keeping this
# session a neutral always-on surface.

# Output configuration - create headless virtual display
output HEADLESS-1 {
    mode {{ virtual_display_width | default(1920) }}x{{ virtual_display_height | default(1080) }}@{{ virtual_display_refresh | default(60) }}Hz
    position 0 0
}

# Disable hardware cursor (better for streaming)
seat seat0 hide_cursor 5000

# Propagate the Wayland session to the user systemd/dbus environment so the
# sunshine user service (and any launched app) inherits WAYLAND_DISPLAY without
# us having to guess the auto-assigned socket name.
exec systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP
exec systemctl --user start sunshine.service
{% if gamescope_session | default(true) %}
# The session itself. Started here (not by Sunshine) on purpose: Sunshine terminates
# the app it launched when the client disconnects, which used to take Steam down with
# it — so every reconnect landed on an empty desktop until Steam was relaunched.
exec systemctl --user start gamescope-session.service
{% endif %}

# No audio sink is created here on purpose. This used to `pactl load-module` a
# null sink, but a runtime module is not durable — it disappeared between
# sessions and left every stream silent. The sink is now declared to PipeWire
# itself, in /etc/pipewire/pipewire.conf.d/ (see pipewire-sunshine-sink.conf.j2),
# so it exists before this session starts and survives it.

# Make the "Desktop" app worth streaming. Sway on its own draws nothing, so
# selecting Desktop in Moonlight used to hand you a perfectly encoded black
# screen with no way to launch anything. A launcher gives the session something
# to show and a way in; the terminal is the escape hatch when it doesn't.
{# This config binds Mod4 directly and never defines $mod — using $mod here makes
   sway reject the line and raise a "There are errors in your config file" bar
   over the streamed session. #}
{% if gaming_desktop_launcher | default(true) %}
# Bind a terminal and a launcher, but do NOT start a terminal automatically. Sway
# tiles, so a permanently-open terminal takes half the output away from Steam — and
# because a game exiting can leave Steam un-fullscreened, that split is what the
# client actually gets. Steam as the sole window fills the screen whether or not it
# is fullscreen, so the fix is to have no second window sitting there by default.
# Both are still one keystroke away over Moonlight's on-screen keyboard.
bindsym Mod4+d exec {{ gaming_desktop_menu | default('wofi --show drun') }}
bindsym Mod4+Shift+Return exec {{ gaming_desktop_terminal | default('foot') }}
{% endif %}

# Sway hosts exactly ONE window: gamescope. Everything the user ever sees — Big
# Picture, games, EA/Ubisoft installers, dialogs — is a client of gamescope, not of
# sway, so sway has no geometry to negotiate and no windows to tile.
#
# This replaces a growing pile of per-app rules that never worked. Sway is a tiling WM:
# it gave each new window a slice of the output, so a game launched beside Big Picture
# was mapped at half width, fixed its swapchain to that, and ignored the later resize
# when a fullscreen rule fired — half the picture off-screen. Fullscreening the newest
# window instead left the previous one un-fullscreened, so Steam came back shrunken
# after a game exited. Floating everything fixed the size but not the fact that sway was
# arbitrating at all. gamescope presents a fixed virtual display and scales clients to
# fill it, which is the actual requirement, and it is what the Steam Deck does.
for_window [app_id="(?i)^gamescope$"] fullscreen enable

# Keybindings for gaming
bindsym Mod4+Return exec xfce4-terminal
bindsym Mod4+q kill
bindsym Mod4+Shift+e exit

# Escape hatches, reachable from Moonlight's on-screen keyboard when a stream has
# nothing but a stuck window on it. Without these, a misbehaving dialog can only be
# cleared by SSHing into the guest.
bindsym Mod4+f fullscreen toggle
bindsym Mod4+Tab focus next

# Gaming-focused settings
focus_follows_mouse no
mouse_warping none

# No window decorations for fullscreen games
default_border none
default_floating_border none

# Include any user customizations
include ~/.config/sway/config.d/*
