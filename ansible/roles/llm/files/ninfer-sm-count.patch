+    last_resident_cols(resident_ctas_27(Bf16GdnGatingScheduleId::MmaCooperativeSplit8), 128, 3, 8);
+inline constexpr std::int32_t k27Split4Last =
+    last_resident_cols(resident_ctas_27(Bf16GdnGatingScheduleId::MmaCooperativeSplit4), 128, 3, 4);
+inline constexpr std::int32_t k27Split2Last =
+    last_resident_cols(resident_ctas_27(Bf16GdnGatingScheduleId::MmaCooperativeSplit2), 128, 3, 2);
+
+inline constexpr std::int32_t k35Split8Last =
+    last_resident_cols(resident_ctas_35(Bf16GdnGatingScheduleId::MmaCooperativeSplit8), 64, 2, 8);
+inline constexpr std::int32_t k35Split4Last =
+    last_resident_cols(resident_ctas_35(Bf16GdnGatingScheduleId::MmaCooperativeSplit4), 64, 2, 4);
+inline constexpr std::int32_t k35Split2Last =
+    last_resident_cols(resident_ctas_35(Bf16GdnGatingScheduleId::MmaCooperativeSplit2), 64, 2, 2);
+
