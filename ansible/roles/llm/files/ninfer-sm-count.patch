Derive the cooperative GDN-gating route bounds from the card's SM count.

Upstream hardcodes the RTX 3090's 82 SMs into the resident-CTA budgets. On
the 64-SM RTX A5000 the split8 route's grid stops fitting above 640 prefill
tokens, and the server dies with cudaErrorCooperativeLaunchTooLarge. Build
with --build-arg NINFER_SM_COUNT=<n>; the default reproduces upstream exactly.

--- a/Dockerfile
+++ b/Dockerfile
@@ -18,11 +18,15 @@
 WORKDIR /src
 COPY . .
 
+# SM count of the target card; see bf16_gdn_gating_proj_plan.cpp. 82 is the RTX 3090.
+ARG NINFER_SM_COUNT=82
+
 RUN cmake -S . -B /build -G Ninja \
         -DCMAKE_BUILD_TYPE=Release \
         -DNINFER_BUILD_APPS=ON \
         -DBUILD_TESTING=OFF \
         -DNINFER_BUILD_BENCHMARKS=OFF \
+        -DCMAKE_CXX_FLAGS=-DNINFER_SM_COUNT=${NINFER_SM_COUNT} \
     && cmake --build /build --parallel --target ninfer ninfer-serve
 
