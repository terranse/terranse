+// Streaming-multiprocessor count of the target card. Upstream tuned for the RTX 3090 (82 SMs);
+// other sm_86 parts have fewer (RTX A5000: 64), and every cooperative route bound below scales with
+// it, so building with the default on a smaller card fails at runtime with
+// cudaErrorCooperativeLaunchTooLarge on the first prefill wide enough to cross a 3090 bound.
+#ifndef NINFER_SM_COUNT
+#define NINFER_SM_COUNT 82
+#endif
+inline constexpr std::int32_t kSmCount = NINFER_SM_COUNT;
+static_assert(kSmCount > 0, "NINFER_SM_COUNT must be positive");
+
+// Device-wide resident-CTA budgets, measured on the sm_86 build. These are the single source of
+// truth: the route table, the runtime residency predicates and the compile-time catalog guard
+// below all read them, so a retuned constant cannot silently disagree with the route bounds.
+constexpr std::int32_t resident_ctas_27(Bf16GdnGatingScheduleId) noexcept {
+    // Uniform across split8/4/2: all three are 8-warp, 65-register CTAs bounded by the same 40 KiB
+    // shared-memory allocation, so all three admit two CTAs per SM.
+    return 2 * kSmCount;
+}
+
+constexpr std::int32_t resident_ctas_35(Bf16GdnGatingScheduleId schedule) noexcept {
+    if (schedule == Bf16GdnGatingScheduleId::MmaCooperativeSplit32) { return 2 * kSmCount; }
+    if (schedule == Bf16GdnGatingScheduleId::MmaCooperativeSplit16) { return 4 * kSmCount; }
+    return 3 * kSmCount;
+}
+
+// The widest token count whose cooperative grid, ceil(T/tile_cols)*row_tiles*split_k, still fits.
+constexpr std::int32_t last_resident_cols(std::int32_t budget, std::int32_t tile_cols,
+                                          std::int32_t row_tiles, std::int32_t split_k) noexcept {
+    return budget / (row_tiles * split_k) * tile_cols;
+}
