# Managed by Ansible (terranse llm role) — DO NOT EDIT.
#
# Open WebUI points at the Hermes gateway API server, not at Ollama, so the chat
# box drives the agent and its tools. That also decouples phone/browser clients
# from the inference backend: swapping Ollama for something else never touches
# this file.
#
# NOTE: these environment variables are read only on Open WebUI's FIRST launch.
# After that the connection lives in its internal SQLite database, so changing
# llm_hermes_api_key here will NOT take effect until the volume is recreated.
# The role checks for this rather than reporting a change that did not happen.
services:
  open-webui:
    image: {{ llm_openwebui_image }}
    container_name: open-webui
    # Bound to all interfaces deliberately: ipid (auth + reverse proxy) is going
    # in front of this, and a LAN-only bind would keep it from reaching here.
    ports:
      - "{{ llm_openwebui_port }}:8080"
    volumes:
      - open-webui:/app/backend/data
    environment:
      - OPENAI_API_BASE_URL=http://host.docker.internal:{{ llm_hermes_api_server_port }}/v1
      - OPENAI_API_KEY={{ llm_hermes_api_key }}
      # Hides the empty Ollama backend from the model picker — the agent is the
      # only thing that should be selectable here.
      - ENABLE_OLLAMA_API=false
      - WEBUI_NAME={{ llm_openwebui_name }}
    extra_hosts:
      - "host.docker.internal:host-gateway"
    restart: always

volumes:
  open-webui:
