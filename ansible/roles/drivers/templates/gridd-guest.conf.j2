# NVIDIA vGPU Guest Licensing Configuration
# Managed by Ansible - do not edit manually

# Enable vGPU licensing.
# FeatureType selects the licensed product and MUST match the assigned vGPU
# profile, or the guest stays Unlicensed:
#   1 = vGPU / vPC, 2 = RTX Virtual Workstation (vWS), 4 = vCompute Server.
# The A5000 Q-series profile (RTXA5000-8Q) is a vWS profile, so use 2.
FeatureType={{ vgpu_feature_type | default(2) }}

# Licensing is handled by nvlts (local trusted store): the license is forged into
# /var/lib/nvidia/vGPULicensing/DataStore.bin by /opt/nvlts/generate-license.sh
# (nvidia-gridd ExecStartPre). No DLS server — nvidia-gridd reads the license
# locally and never contacts a network license server.

# Logging
EnableLog=1
LogFilePath=/var/log/nvidia/gridd.log
LogLevel=3

# Heartbeat configuration
LicenseInterval=600
