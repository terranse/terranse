.terraform*
# Terraform/OpenTofu state — never commit, can contain secrets even when
# sensitive attributes are used (e.g. data source flattening).
**/terraform.tfstate
**/terraform.tfstate.backup
**/terraform.tfstate.*.backup
**/tfplan
**/tfplan-*
*/inventory.yaml
ansible/playbook.yaml
# Per-deployment playbook + inventory generated by the tofu ansible-wiring
# module — build outputs, regenerated on every apply, never hand-edited.
/ansible/playbooks/edholm.yaml
/ansible/inventory/edholm.yaml
/ansible/roles/geerlingguy.docker
packer/proxmox.pkrvars.hcl
packer/*/downloaded_iso_path/

# Worktrees
.worktrees/

# Local agent state: Claude Code settings and worktrees, and a stray
# agent-memory directory -- per machine, never part of the repo.
/.claude/
/ansible/memory/

# Python build artifacts
*.egg-info/
__pycache__/
*.pyc

# media audit local dumps
docs/media-audit/.cache/

# Nix
result
result-*
